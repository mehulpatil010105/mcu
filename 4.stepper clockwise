#include <reg51.h>

void delay(unsigned char);

void main()
{
    while(1)
    {
        P1 = 0x01;

        delay(0);

        P1 = 0x02;

        delay(0);

        P1 = 0x04;

        delay(0);

        P1 = 0x08;

        delay(0);
    }
}

