#include <reg51.h>

void delay(unsigned int);

void main()
{
    P1 = 0x00;

    while(1)
    {
        do
        {
            P1 += 0x05;

            delay(50);

        } while(P1 < 0xff);

        do
        {
            P1 -= 0x05;

            delay(50);

        } while(P1 > 0x00);
    }
}

void delay(unsigned int time)
{
    unsigned int x, y;

    for(x = 0; x < time; x++)
        for(y = 0; y < 1200; y++);
}
